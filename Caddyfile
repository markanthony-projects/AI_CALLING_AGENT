# The DNS A record for this name must already point at the droplet before first start, or
# Caddy cannot complete the certificate challenge.
ai-calls.homebble.in {
	reverse_proxy api:8000

	log {
		output file /var/log/caddy/access.log {
			roll_size 20mb
			roll_keep 10
		}
		# The answer and stream URLs carry a live call token in the query string. Uvicorn's
		# own log filter cannot reach this logger, so Caddy has to redact it separately or
		# every callback writes a replayable token to disk.
		format filter {
			wrap console
			fields {
				request>uri query {
					replace token REDACTED
				}
			}
		}
	}

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}
}
