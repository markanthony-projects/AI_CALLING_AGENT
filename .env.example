# Leave unset in production. Set to false ONLY for local testing on a private host.
AUTH_ENABLED=true
# Publishes your full route list and request shapes. Leave unset on a public host.
DOCS_ENABLED=false
# Management API auth. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Signs short-lived telephony callback tokens. Generate the same way. Min 32 chars.
CALL_TOKEN_SECRET=
CALL_TOKEN_TTL_SECONDS=900

# DigitalOcean managed Postgres: use the VPC/private connection string and append
# ?ssl=require. Without it asyncpg defaults to ssl=prefer, which silently accepts a
# plaintext fallback and does not verify the server certificate.
DATABASE_URL=postgresql+asyncpg://user:password@private-host.ondigitalocean.com:25060/voiceagent?ssl=require
# Redis runs as a container on the same droplet; compose overrides this to redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

DEEPGRAM_API_KEY=
SARVAM_API_KEY=
SARVAM_VOICE_ID=simran
OPENAI_API_KEY=
GROQ_API_KEY=

VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_PHONE_NUMBER=
WEBHOOK_BASE_URL=https://your-public-host
# Applied to lead numbers submitted without a country code
DEFAULT_COUNTRY_CODE=91

# Spend ceilings on outbound dialing, counted in numbers dialled, not requests. Vobiz bills
# at dial time, so these bound what a leaked API key can cost you. Day boundary is IST.
DIAL_MAX_PER_MINUTE=30
DIAL_MAX_PER_DAY=500
