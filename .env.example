# Leave unset in production. Set to false ONLY for local testing on a private host.
AUTH_ENABLED=true
# Publishes your full route list and request shapes. Leave unset on a public host.
DOCS_ENABLED=false
# Management API auth. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Signs short-lived telephony callback tokens. Generate the same way. Min 32 chars.
CALL_TOKEN_SECRET=
CALL_TOKEN_TTL_SECONDS=900

# --- Operations dashboard ---
# Signs dashboard login sessions. Generate the same way; min 32 chars. Leave EMPTY to
# disable the dashboard entirely — /api/v1/auth and /api/v1/dashboard then return 503.
# Must differ from CALL_TOKEN_SECRET: call tokens are handed to Vobiz and appear in URLs,
# and must never be presentable as a login.
DASHBOARD_SESSION_SECRET=
DASHBOARD_SESSION_TTL_SECONDS=43200
# Leave EMPTY when nginx serves the dashboard on the same host as the API (the default and
# the recommended setup) — CORS is then unnecessary and the session cookie stays SameSite=Lax.
# Set it only for a separately hosted dashboard, e.g. https://dashboard.homebble.in
DASHBOARD_CORS_ORIGINS=
# Set to false ONLY for plain-HTTP local dev. A Secure cookie is never sent over http://,
# so leaving this true locally makes login appear to work and every later request 401.
DASHBOARD_COOKIE_SECURE=true
# lax | none. The dashboard is a separate repo deployed to Vercel, so what matters is
# whether it is the same SITE, not merely a different origin:
#   dashboard.homebble.in  (Vercel custom domain)  -> same site  -> leave this as lax
#   your-app.vercel.app    (default Vercel domain) -> cross site -> must be none
# none makes the session a third-party cookie, which Safari and Firefox block by default —
# login there will not stick. Prefer a homebble.in subdomain on Vercel and keep lax.
DASHBOARD_COOKIE_SAMESITE=lax

# DigitalOcean managed Postgres. Append ?ssl=require — without it asyncpg defaults to
# ssl=prefer, which silently accepts a plaintext fallback and skips certificate checks.
# Access is restricted by the cluster's Trusted Sources list, not by network placement.
DATABASE_URL=postgresql://doadmin:password@your-db-host.ondigitalocean.com:25060/defaultdb?ssl=require

# Postgres connections per process. The api and worker containers each open their own pool
# against one managed cluster, whose connection limit is around twenty — the default here is
# unbounded overflow, and exhausting it surfaces as calls that cannot write their own rows.
# 5 + 5 is far more than three concurrent calls and a dashboard need.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Managed Postgres drops idle connections, and a pooled connection that died in the
# background is only discovered by whatever needs it next — here, a live call.
DB_POOL_RECYCLE_SECONDS=1800
# Redis runs as a container on the same droplet; compose overrides this to redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

DEEPGRAM_API_KEY=
SARVAM_API_KEY=
SARVAM_VOICE_ID=simran
OPENAI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Which provider serves the calls. Deliberately configuration and not a class name: Groq
# deprecated llama-3.3-70b-versatile with six weeks' notice and closed its self-serve paid
# tier. Any endpoint speaking the OpenAI wire format works. Leave LLM_API_KEY blank and the
# provider's own key below is used; it is resolved per provider, so pointing LLM_BASE_URL at
# a different vendor can never silently hand it the previous vendor's credential.
#
# The model was chosen by replaying a real call against every candidate and scoring the
# rules live calls had actually broken, not by tokens per second:
#
#   cerebras gemma-4-31b     503ms TTFB   end_call via the tool channel   name in 6/6 replies
#   cerebras gpt-oss-120b    559ms        tool                            5/6, ran a turn behind
#   cerebras zai-glm-4.7    1446ms        tool                            5/6, 5.8s worst case
#   groq     llama-3.3-70b   400ms        WROTE end_call INTO ITS SPEECH  deprecated Aug 2026
#   openai   gpt-4o-mini    1100ms        no end_call on a clear goodbye
#
# Rate limits matter as much as speed. Groq's free tier allows 12,000 tokens/minute against
# a 3,400-token request — under three turns a minute, for a conversation that needs ten.
# Cerebras's Developer tier ($10) allows 500,000 tokens and 500 requests a minute, which is
# roughly 24 concurrent calls. Its free tier allows 5 requests a minute and cannot carry one.
LLM_PROVIDER_NAME=cerebras
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_API_KEY=
LLM_MODEL=gemma-4-31b

# A second OpenAI-wire-format provider used only when the primary refuses a turn on a rate
# limit. Off unless BOTH the key and the model are set — a half-configured fallback looks
# like insurance and fails at the one moment it is needed. Any OpenAI-compatible endpoint
# works; the base URL and model decide the provider.
#   Cerebras: LLM_FALLBACK_BASE_URL=https://api.cerebras.ai/v1  MODEL=gpt-oss-120b
#   OpenAI:   LLM_FALLBACK_BASE_URL=https://api.openai.com/v1   MODEL=gpt-4o-mini
LLM_FALLBACK_NAME=openai
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://api.openai.com/v1
LLM_FALLBACK_MODEL=

VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_PHONE_NUMBER=
WEBHOOK_BASE_URL=https://your-public-host
# Applied to lead numbers submitted without a country code
DEFAULT_COUNTRY_CODE=91

# Spend ceilings on outbound dialing, counted in numbers dialled, not requests. Vobiz bills
# at dial time, so these bound what a leaked API key can cost you. Day boundary is IST.
DIAL_MAX_PER_MINUTE=30
DIAL_MAX_PER_DAY=500

# Streams accepted at once. Roughly two per vCPU before audio starts breaking up.
# Never above what the carrier account allows. The Vobiz account permits 3 simultaneous
# calls; this is now the DIAL gate too, so a higher value here spends money on calls the
# carrier will refuse.
MAX_CONCURRENT_CALLS=3

# How long a number may ring before the carrier gives up, in seconds.
#
# The carrier's own default is a minute or more. That is a minute of somebody's phone buzzing
# for a call they have decided not to take — and, because a slot is reserved before the dial
# and freed only when the hangup callback arrives, a minute of a three-slot account's capacity
# spent on nothing.
VOBIZ_RING_SECONDS=30

# Refuse to dial when the LLM cannot answer the opening turn — about one request's worth of
# tokens. The carrier leg is billed and a real person's phone rings either way, so a dial
# placed with an empty token bucket just means they hear silence. 0 disables the check.
LLM_MIN_TOKENS_TO_DIAL=4000

# How long after the prospect stops making sound their turn stays open for them to carry on.
# This is silence on EVERY turn, and it does not show up in the LATENCY log lines — those
# start counting only once this window has already elapsed.
#
# It ran at 0.8s while a split turn could put two replies on the line ("Maybe around in 2"
# / "months." arriving as two turns, each answered out loud). TurnFinalityGate now holds the
# stale half back, so a split costs one extra inference and the caller hears nothing wrong.
# That made this a cost setting rather than a correctness one, and it was spent on latency.
# Raise it if the extra inferences ever matter more than the wait.
TURN_SETTLE_SECS=0.4
