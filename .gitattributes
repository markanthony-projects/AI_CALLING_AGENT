# These files are authored on Windows but consumed by Linux tools inside containers and on
# the droplet. Without eol=lf, git checks them out with CRLF and bash fails on the shebang
# with "/bin/bash^M: bad interpreter: No such file or directory" — a confusing error for a
# line-ending problem.
*.sh        text eol=lf
*.conf      text eol=lf
*.sql       text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
.env.example text eol=lf
